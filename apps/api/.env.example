# PostgreSQL connection string (rivestack). Keep the real value in .env (gitignored).
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Optional: override the published Google Sheets CSV URLs used by `bun run db:seed`.
# If unset, the seed falls back to the same URLs the web app uses.
# SEED_CARDS_CSV=
# SEED_LOCATIONS_CSV=
# SEED_TRANSIT_CS_CSV=
# SEED_TRANSIT_EN_CSV=
# SEED_POWERUP_CS_CSV=
# SEED_POWERUP_EN_CSV=
